# Copy to `market-secrets.env`, fill in, `chmod 600` it, then
# `docker compose up -d`.
#
# Read with `format: raw`, so values are passed through verbatim: paste the
# generated hash exactly as printed, `$` signs and all, and do not quote it.
# (That is exactly why this file exists separately from `.env` — see the
# `env_file` comment in docker-compose.yml.)

# Admin password, as a bcrypt or argon2 hash. Plaintext is rejected at startup.
# Generate one without leaving the password in your shell history:
#
#   read -rs PW && printf '%s' "$PW" | docker run --rm -i oven/bun:1 \
#     bun -e 'console.log(await Bun.password.hash((await Bun.stdin.text()).trim(), { algorithm: "argon2id" }))'
MCPM_ADMIN_PASSWORD_HASH=

# Signs the admin session cookie, minimum 32 characters. Rotating it invalidates
# every existing session. Generate one with: openssl rand -hex 32
MCPM_SESSION_SECRET=
