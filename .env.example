# Copy to `.env` and fill in, then `docker compose up -d`.
#
# This file holds deployment parameters only. Credentials go in
# `market-secrets.env` (see `market-secrets.env.example`) because every value
# here is also read for `${...}` interpolation, which mangles `$`-heavy hashes.
#
# Compose reads this file twice: for interpolation (image, port, bind address)
# and, via `env_file`, as the container environment. A change only reaches the
# container after `docker compose up -d` recreates it.

# --- image -----------------------------------------------------------------
# What the server pulls: the image CI publishes for this repository, lowercased
# because registry paths are lowercase-only. A wrong value fails the pull rather
# than silently reusing a stale local image.
MCPM_IMAGE=ghcr.io/konghayao/mcpp:latest

# --- published port --------------------------------------------------------
# Nothing terminates TLS in docker-compose.yml, so 0.0.0.0 publishes the admin
# console over plain HTTP. Narrow it to 127.0.0.1 and put a reverse proxy in
# front when the host is not on a trusted network.
MCPM_PORT=3000
MCPM_BIND_ADDRESS=0.0.0.0

# --- application -----------------------------------------------------------
MCPM_ADMIN_USERNAME=admin

# Metadata source; only the npm registry protocol is implemented.
MCPM_REGISTRY_URL=https://registry.npmjs.org

# --- TLS and reverse proxy -------------------------------------------------
# Must be `false` while the site is served over plain HTTP: browsers drop a
# `Secure` cookie sent over http, so login would appear to succeed and then
# bounce straight back to the login page.
MCPM_SECURE_COOKIES=false

# Set to `true` only when a reverse proxy is genuinely in front. It makes the
# app trust `X-Forwarded-*` headers, and the login rate limiter keys on the
# client IP those headers carry.
MCPM_TRUST_PROXY=false

# --- optional --------------------------------------------------------------
# MCPM_SESSION_TTL_SECONDS=3600
# MCPM_REGISTRY_TIMEOUT_MS=8000
# MCPM_REGISTRY_MAX_BYTES=4194304
# MCPM_SOURCE_ID=npm
# MCPM_REGISTRY_HOMEPAGE_URL=
