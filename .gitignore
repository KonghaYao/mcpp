node_modules/
dist/
# The echo-mcp fixture's `dist/` is hand-written source, not build output:
# `worker-host.ts` imports it and `mcpp.servers.default.entry` points at it. The
# `dist/` rule above hides it from every fresh clone, which is exactly how three
# worker tests passed locally and failed in CI.
!examples/mcp-registry/fixtures/echo-mcp/dist/
!examples/mcp-registry/fixtures/echo-mcp/dist/*.js
examples/plugins/monorepo/dist-worker/
examples/mcp-registry/data/
# 本地文件上传示例的运行时存储，不纳入源码提交。
.mcpp-files/
*.tsbuildinfo
.env
.env.*
!.env.example
market-secrets.env
.DS_Store
*.log
coverage/
*.tgz
.claude/
.peri/
handoffs/