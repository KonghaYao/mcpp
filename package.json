{
  "name": "mcpp",
  "private": true,
  "description": "MCPP 规范、参考实现与示例 workspace",
  "workspaces": [
    "examples/plugins/monorepo",
    "examples/mcp-registry",
    "examples/anydoc-mcp",
    "packages/mcpp"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run --cwd packages/mcpp typecheck",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss,html,md,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "3.6.2"
  }
}
