{
  "name": "@open-mcp-market/anydoc-mcp-demo",
  "version": "0.1.1",
  "description": "A guarded stdio MCP server that converts local documents to Markdown with Firecrawl AnyDoc",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "mcp-plugin",
    "anydoc",
    "document",
    "markdown"
  ],
  "files": [
    "dist",
    "mcp.json",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/server.ts --target=node --format=esm --external @firecrawl/anydoc --external @modelcontextprotocol/server --external zod --outdir=dist",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@firecrawl/anydoc": "0.2.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@peri-code/mcpp": "^0.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
